# ==============================================================================
# 农智云（AgriTech 中国大陆本地化版）环境变量模板
#
# 使用方法：
#   1. 复制为项目根目录下的 .env 文件
#   2. 填入自己的密钥（.env 已被 .gitignore 忽略，切勿提交）
#   3. 运行 启动平台.cmd
#
# 不配置任何大模型密钥也能启动：平台会进入“基础演示模式”，
# AI 助手使用本地规则库并明确标注为离线回答。
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 应用与本地服务
# ------------------------------------------------------------------------------
FLASK_ENV=development
DEBUG=False
SECRET_KEY=请替换为随机字符串_例如_agri_tech_cn_local_2026
HOST=127.0.0.1
PORT=5000
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:8080,http://127.0.0.1:8080

# ------------------------------------------------------------------------------
# 2. 数据库（本地 SQLite，无需安装 MySQL / MongoDB）
# ------------------------------------------------------------------------------
DATABASE_URL=sqlite:///agritech_dev.db
DEV_DATABASE_URL=sqlite:///agritech_dev.db
DATABASE_ECHO=False

# ------------------------------------------------------------------------------
# 3. 登录与鉴权
# ------------------------------------------------------------------------------
JWT_SECRET=请替换为随机字符串_例如_change_me_agritech_cn_jwt
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_HASH_ROUNDS=12

# ------------------------------------------------------------------------------
# 4. AI 助手（DeepSeek / OpenAI 兼容接口）
#    密钥仅保存在服务端，绝不会下发到浏览器。
# ------------------------------------------------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
AI_TIMEOUT_SECONDS=60
AI_MAX_TOKENS=1200
AI_TEMPERATURE=0.5

# 若改用其他 OpenAI 兼容服务（例如通义千问、智谱、硅基流动等），填写以下三项：
# AI_API_KEY=
# AI_BASE_URL=https://your-provider.example.com/v1
# AI_MODEL=your-model-name

# ------------------------------------------------------------------------------
# 5. 植物病害模型
#    权重已修复并实测验证（3/3 自检命中）。设为 1 开启图片识别；
#    需安装 requirements-cn-ml.txt（torch/torchvision），自检失败会自动禁用。
# ------------------------------------------------------------------------------
ENABLE_PLANT_MODEL=1
PLANT_MODEL_SELF_CHECK=true

# ------------------------------------------------------------------------------
# 6. 农业气象（可选）
#    不配置时使用本地演示气象并明确标注；已内置 Open-Meteo 免密钥接入。
# ------------------------------------------------------------------------------
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
WEATHER_API_KEY=
WEATHER_API_URL=https://api.weatherapi.com/v1

# ------------------------------------------------------------------------------
# 7. 缓存与队列（本地演示默认使用 SimpleCache，不依赖 Redis）
# ------------------------------------------------------------------------------
CACHE_TYPE=SimpleCache
CACHE_DEFAULT_TIMEOUT=3600
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 8. 邮件（可选，忘记密码等邮件功能需要配置）
# ------------------------------------------------------------------------------
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@example.com

# ------------------------------------------------------------------------------
# 9. 上游遗留配置（本地演示不依赖，保留以便追溯原始项目）
# ------------------------------------------------------------------------------
# GEMINI_API_KEY=            # 原项目使用，现已由 DEEPSEEK 替代
# FIREBASE_API_KEY=          # 原项目使用 Firebase 认证，现已改为本地 SQLite
# GOOGLE_TRANSLATION_API_KEY= # 原项目依赖在线翻译，现改为本地词典
# TWILIO_ACCOUNT_SID=        # 短信服务，未接入
# WEATHER_API_KEY=            # 第三方气象密钥，可选
