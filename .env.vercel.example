# Vercel 部署环境变量（线上环境用）
# 用法：vercel env add <变量名> production < <本文件中的值>，或直接在 Vercel 控制台添加。
# 注意：Vercel 的容器文件系统不持久，注册/登录数据写在 /tmp，重建后会重置。

# 运行环境
FLASK_ENV=production
DEBUG=False
HOST=0.0.0.0
PORT=80
SECRET_KEY=请替换为随机长字符串
JWT_SECRET=请替换为另一个随机长字符串
CORS_ORIGINS=https://你的域名.vercel.app

# 数据库（容器内临时 SQLite，重建后重置）
DATABASE_URL=sqlite:////tmp/agritech.db

# 缓存（Vercel 无 Redis，使用进程内缓存）
CACHE_TYPE=SimpleCache
CACHE_DEFAULT_TIMEOUT=3600

# 病害模型：上游权重自检未通过，线上保持禁用
ENABLE_PLANT_MODEL=0

# 可选：填入有效密钥后 AI 助手自动切换为在线模式；留空则使用本地规则库
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
